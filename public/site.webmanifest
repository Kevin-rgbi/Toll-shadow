{
  "name": "Toll Shadow",
  "short_name": "Toll Shadow",
  "description": "A public explorer for New York City traffic observations around the Congestion Relief Zone: what was observed, over which window, and where the data stops.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fcfcfb",
